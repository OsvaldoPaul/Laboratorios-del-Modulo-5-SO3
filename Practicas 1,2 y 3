sudo dnf config-manager --set-enabled highavailability
# Habilita el repositorio de alta disponibilidad

sudo dnf install pacemaker -y
# Instala Pacemaker (motor del clúster)

sudo firewall-cmd --permanent --add-service=high-availability
# Permite servicios del clúster en el firewall

sudo firewall-cmd --reload
# Recarga las reglas del firewall

sudo dnf install pcs -y
# Instala PCS (administrador del clúster)

sudo systemctl enable pcsd --now
# Activa y arranca el servicio de control de PCS

echo "123rio7778" | sudo passwd --stdin hacluster
# Asigna contraseña al usuario de clúster

sudo pcs host auth node1 addr=192.168.1.18 node2 addr=192.168.1.17 -u hacluster
# Autentica ambos nodos para el clúster

sudo pcs cluster setup pacemaker1 node1 addr=192.168.1.18 node2 addr=192.168.1.17
# Configura el clúster y define sus nodos

sudo pcs cluster start --all
# Inicia el clúster en ambos nodos

sudo systemctl start pacemaker.service
# Inicia el servicio pacemaker en el sistema

sudo pcs cluster enable --all
# Habilita que el clúster arranque automáticamente

sudo systemctl enable pacemaker.service
# Habilita pacemaker para iniciar al encender

sudo pcs property set stonith-enabled=false
# Desactiva STONITH 

sudo pcs resource create ClusterIP ocf:heartbeat:IPaddr2 ip=192.168.1.200 cidr_netmask=24 op monitor interval=30s
# Crea la IP flotante que migrará entre nodos

