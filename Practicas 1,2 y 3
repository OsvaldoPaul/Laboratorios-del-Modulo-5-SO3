sudo dnf install httpd -y
# Instala el servidor web Apache

cd /var/www/html/
# Entra al directorio donde se aloja el index

nano index.html
# Crea/edita la página que mostrará qué servidor es

systemctl start httpd
# Inicia el servicio web

systemctl status httpd
# Verifica que Apache esté activo

ip a
# Obtiene las IP para probar en el navegador

sudo dnf install keepalived -y
# Instala Keepalived (manejador de IP flotante)

cd /etc/keepalived/
# Entra a la carpeta de configuración de Keepalived

ls
# Lista los archivos existentes

rm -rf *
# Elimina configuraciones por defecto que no se usarán

ls
# Verifica que la carpeta esté limpia

nano keepalived.conf
# Crea el archivo de configuración personalizado

# ----- CONFIGURACIÓN SERVIDOR MASTER -----
vrrp_instance VI_1 {
    state MASTER
    interface ens33
    virtual_router_id 51
    priority 60
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass PS3
    }
    virtual_ipaddress {
        192.168.1.200
    }
}

# ----- CONFIGURACIÓN SERVIDOR BACKUP -----
vrrp_instance VI_1 {
    state BACKUP
    interface ens33
    virtual_router_id 51
    priority 50
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass PS3
    }
    virtual_ipaddress {
        192.168.1.200
    }
}

systemctl start keepalived
# Inicia el servicio que gestiona la IP flotante

systemctl status keepalived
# Verifica que el servicio esté activo

ip a
